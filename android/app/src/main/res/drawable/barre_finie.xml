<?xml version="1.0" encoding="utf-8"?>
<!-- La barre de la file finie : remplissage vert pale, bord sombre (maquette 2). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="#FF1B1F24" />
            <stroke android:width="2dp" android:color="#FF0A0C0F" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item
        android:id="@android:id/progress"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <clip>
            <shape>
                <solid android:color="#FFA5D6A7" />
                <corners android:radius="5dp" />
            </shape>
        </clip>
    </item>
</layer-list>
