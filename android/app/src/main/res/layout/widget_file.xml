<?xml version="1.0" encoding="utf-8"?>
<!-- Le widget « Simulations » : mockups/iPhone 17 - 1.png et - 2.png. Tout ce qui change
     est ecrit par WidgetFile.dessine() ; ce fichier ne donne que la forme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fond_widget"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/titre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="Simulations"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1">

            <ProgressBar
                android:id="@+id/barreEncours"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/barre_encours" />

            <ProgressBar
                android:id="@+id/barreFinie"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progress="100"
                android:progressDrawable="@drawable/barre_finie"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pct"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:textColor="#FF1A1A1A"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/btnStop"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bouton_carre"
            android:gravity="center"
            android:text="■"
            android:textColor="#FFE53935"
            android:textSize="18sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnPause"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bouton_carre"
            android:gravity="center"
            android:text="❚❚"
            android:textColor="#FF43A047"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/ligne0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ligne1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ligne2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ligne3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ligne4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnAnalyser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bouton"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="12dp"
        android:paddingBottom="7dp"
        android:text="Analyser les résultats"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/pied"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="touche pour actualiser"
        android:textColor="#FF8A93A3"
        android:textSize="10sp" />
</LinearLayout>
